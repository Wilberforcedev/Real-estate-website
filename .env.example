# GEMINI_API_KEY: Required for the AI neighborhood insights and property chat endpoints.
# It is read only on the server and never sent to the browser.
GEMINI_API_KEY=""

# Public URL of the deployment (optional, used for self-referential links).
APP_URL="http://localhost:3000"

# Server runtime
NODE_ENV="development"
PORT="3000"

# Set to 1 when running behind a trusted reverse proxy / load balancer so client IPs
# are read from X-Forwarded-For. Leave 0 when the server is directly exposed.
TRUST_PROXY="0"

# Gemini model used for both AI endpoints.
GEMINI_MODEL="gemini-3.6-flash"

# AI request timeout in milliseconds.
AI_TIMEOUT_MS="30000"

# Per-IP rate limits. The AI limit covers the AI endpoints combined; the API limit applies
# to every /api request. Windows are expressed in milliseconds.
AI_RATE_LIMIT="20"
AI_RATE_WINDOW_MS="300000"
API_RATE_LIMIT="300"
API_RATE_WINDOW_MS="60000"


# Shared Python/PostgreSQL data service
DATA_API_URL="http://127.0.0.1:8000"
# Use a long random password in deployments and keep .env out of Git.
POSTGRES_PASSWORD="replace-with-a-long-random-value"
APP_ENV="development"
SESSION_COOKIE_SECURE="false"
